{
  "docker": [
    {
      "args": [
        "pull",
        "ghcr.io/github/github-mcp-server"
      ],
      "cwd": "isolated",
      "executable": "docker",
      "id": "docker-pull",
      "kind": "run",
      "network": true,
      "timeoutMs": 600000
    },
    {
      "client": "cursor",
      "file": ".cursor/mcp.json",
      "id": "config-cursor-project",
      "kind": "config-patch",
      "path": [
        "mcpServers",
        "github"
      ],
      "scope": "project",
      "value": {
        "args": [
          "run",
          "-i",
          "--rm",
          "-e",
          "GITHUB_PERSONAL_ACCESS_TOKEN",
          "ghcr.io/github/github-mcp-server"
        ],
        "command": "docker",
        "env": {
          "GITHUB_PERSONAL_ACCESS_TOKEN": "${env:GITHUB_PERSONAL_ACCESS_TOKEN}"
        }
      }
    }
  ],
  "npx": [
    {
      "client": "claude-code",
      "file": ".mcp.json",
      "id": "config-claude-code-project",
      "kind": "config-patch",
      "path": [
        "mcpServers",
        "fixture-npx"
      ],
      "scope": "project",
      "value": {
        "args": [
          "-y",
          "@openhub-fixture/npx-mcp"
        ],
        "command": "npx"
      }
    }
  ],
  "uvx": [
    {
      "args": [
        "--no-build",
        "--compile-bytecode",
        "--from",
        "postgres-mcp==0.3.0",
        "--with",
        "mcp==1.30.0",
        "python",
        "-c",
        "pass"
      ],
      "cwd": "isolated",
      "executable": "uvx",
      "id": "uvx-prepare",
      "kind": "run",
      "network": true,
      "timeoutMs": 600000
    },
    {
      "client": "claude-code",
      "file": ".mcp.json",
      "id": "config-claude-code-project",
      "kind": "config-patch",
      "path": [
        "mcpServers",
        "postgres"
      ],
      "scope": "project",
      "value": {
        "args": [
          "--no-build",
          "--from",
          "postgres-mcp==0.3.0",
          "--with",
          "mcp==1.30.0",
          "postgres-mcp",
          "--access-mode=restricted"
        ],
        "command": "uvx",
        "env": {
          "DATABASE_URI": "${DATABASE_URI}"
        }
      }
    },
    {
      "client": "codex",
      "file": ".codex/config.toml",
      "id": "config-codex-project",
      "kind": "config-patch",
      "path": [
        "mcp_servers",
        "postgres"
      ],
      "scope": "project",
      "value": {
        "args": [
          "--no-build",
          "--from",
          "postgres-mcp==0.3.0",
          "--with",
          "mcp==1.30.0",
          "postgres-mcp",
          "--access-mode=restricted"
        ],
        "command": "uvx",
        "env_vars": [
          "DATABASE_URI"
        ]
      }
    }
  ]
}
